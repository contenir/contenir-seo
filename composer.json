{
    "name": "contenir/contenir-seo",
    "description": "Framework-free SEO for Contenir: title templates, robots directives and robots.txt, site verification, JSON-LD Organization and WebSite, and an XML sitemap writer with images and an index past 50,000 URLs.",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": [
        "contenir",
        "seo",
        "sitemap",
        "robots",
        "json-ld",
        "open-graph"
    ],
    "homepage": "https://contenir.com.au",
    "support": {
        "issues": "https://github.com/contenir/contenir-seo/issues",
        "source": "https://github.com/contenir/contenir-seo"
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "ext-xmlwriter": "*",
        "contenir/contenir-contact": "^0.1"
    },
    "require-dev": {
        "contenir/contenir-qa-tools": "0.1.x-dev",
        "infection/infection": "^0.34.1",
        "phpunit/phpunit": "^11.5.42"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\Seo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Seo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "../contenir-contact"
        }
    ]
}
